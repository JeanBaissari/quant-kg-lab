# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node
node_modules/
.graphify-cli/

# Backups from scripts/describe_nodes.py --apply
*.predesc.bak

# Graphify intermediates — committed artifacts (graph.json, GRAPH_REPORT.md,
# .graphify_labels.json) are explicitly NOT ignored; see GRAPH_SPEC §1.
.graphify/.graphify_detect.json
.graphify/.graphify_extract.json
.graphify/.graphify_analysis.json
.graphify/.graphify_ast.json
.graphify/.graphify_semantic.json
.graphify/.graphify_incremental.json
.graphify/.graphify_old.json
.graphify/.vocab.txt
.graphify/branch.json
.graphify/worktree.json
.graphify/needs_update
.graphify/cache/
.graphify/cost.json
.graphify/memory/
.graphify/wiki/

# Cloned repos (too large, reclone via scripts/setup.sh)
knowledge_graphs/*/repo/


# Graphify backups (prune/label/describe safety copies)
*.prune.bak
*.labels.bak
